# Copy to .env and fill in locally. All values below are placeholders.
# Redacted from the original root Readme.md (which contained live secrets).
# See app/docs/lab-notes.md for the redacted learning notes.

# Network proxy (original contained proxy creds — redacted, see git history)
HTTP_PROXY=http://<user>:<pass>@<proxy-host>:<proxy-port>
HTTPS_PROXY=http://<user>:<pass>@<proxy-host>:<proxy-port>

# HuggingFace (original contained two live hf_* tokens — revoked/redacted)
HF_TOKEN=<your-huggingface-token>

# SQL Server connections (see backend/config.py + legacy/rag_preprocess.py)
# Canonical: localhost\SQLEXPRESS / CONTROLS (Trusted_Connection)
# Legacy RAG: DESKTOP-FG7N2DC\SQLEXPRESS / flogbook.fault_bookv3
SQL_SERVER=localhost\SQLEXPRESS
SQL_DATABASE=CONTROLS

# Local model / data paths (all git-ignored; override absolute legacy paths)
EMBEDDER_MODEL_PATH=./models/embedding/bge-en
INTENT_CLASSIFIER_MODEL=./models/intent_classifier/intent_classifier_model
PHI3_MODEL_PATH=./models/llms/Phi-3-mini-4k-instruct-q4.gguf
DEEPSEEK_MODEL_PATH=./models/llms/DeepSeek-R1-Distill-Llama-8B-Q4_K_M.gguf
LLAMA31_MODEL_PATH=./models/llms/Hermes-3-Llama-3.1-8B.Q4_K_M.gguf
CHROMA_DB_DIR=./app/backend/chroma_db
LOG_DIRECTORY=./app/backend/logs/app.log

# ChromaDB telemetry (original lab note)
CHROMA_TELEMETRY_SETTINGS={"anonymized_telemetry": false}

# Jupyter / Flask ports used in notes
JUPYTER_TOKEN=<your-jupyter-token>
FLASK_PORT=5000
